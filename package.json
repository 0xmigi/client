{
  "name": "life-heatmap",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0",
  "description": "GitHub-style heatmap dashboard for personal tracking (running, sleep, etc.)",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "date-fns": "^2.30.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "styled-components": "^5.3.3",
    "zod": "^3.23.8"
  },
  "scripts": {
    "start": "webpack-dev-server --mode development --hot",
    "build": "webpack --mode production",
    "ingest": "ts-node --transpile-only scripts/ingest.ts",
    "mcp": "ts-node --transpile-only scripts/mcp-server.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "exit 0",
    "clean": "del-cli dist node_modules",
    "deploy": "netlify build && netlify deploy",
    "deploy:prod": "netlify build && netlify deploy --prod"
  },
  "browserslist": {
    "production": [
      "last 1 chrome version",
      "last 1 firefox version"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version"
    ]
  },
  "engines": {
    "node": ">=16"
  },
  "resolutions": {
    "@types/react": "^17.0.34",
    "@types/react-dom": "^17.0.11"
  },
  "devDependencies": {
    "@babel/core": "^7.17.5",
    "@babel/preset-env": "^7.16.11",
    "@babel/preset-react": "^7.16.7",
    "@babel/preset-typescript": "^7.16.7",
    "@types/node": "^18.19.0",
    "@types/react": "^17.0.34",
    "@types/react-dom": "^17.0.11",
    "@types/sax": "^1.2.7",
    "@types/styled-components": "^5.1.15",
    "babel-loader": "^8.2.3",
    "babel-plugin-styled-components": "^2.0.5",
    "copy-webpack-plugin": "^9.0.1",
    "css-loader": "^6.5.1",
    "del-cli": "^4.0.1",
    "dotenv": "^10.0.0",
    "eslint": "^7.30.0",
    "fork-ts-checker-webpack-plugin": "^7.2.1",
    "html-webpack-plugin": "^5.5.0",
    "netlify-cli": "^3.8.5",
    "prettier": "^2.3.0",
    "sax": "^1.3.0",
    "source-map-loader": "^3.0.0",
    "style-loader": "^3.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "webpack": "^5.62.1",
    "webpack-cli": "^4.9.1",
    "webpack-dev-server": "^4.4.0"
  }
}
